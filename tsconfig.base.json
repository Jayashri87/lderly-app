{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/app/*": ["app/*"],
      "@/components/*": ["components/*"],
      "@/lib/*": ["lib/*"],
      "@/server/*": ["server/*"],
      "@/services/*": ["services/*"],
      "@/types/*": ["types/*"],
      "@lderly/analytics": ["packages/analytics/src/index.ts"],
      "@lderly/payment": ["packages/payment/src/index.ts"],
      "@lderly/shared-types": ["packages/shared-types/src/index.ts"],
      "@lderly/shared-types/*": ["packages/shared-types/src/*"],
      "@lderly/validation-schemas": ["packages/validation-schemas/src/index.ts"]
    }
  }
}
