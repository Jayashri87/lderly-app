{
  "name": "lderly-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bundle:size": "node scripts/bundle-size-report.mjs",
    "lighthouse": "node scripts/lighthouse-report.mjs",
    "load:test": "node scripts/load-test.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json .prettierrc.json .github/**/*.yml .github/**/*.json scripts/apply-branch-protection.mjs",
    "prepare": "husky",
    "verify:env": "node scripts/verify-production-env.mjs",
    "audit:deps": "pnpm audit --audit-level=moderate",
    "audit:secrets": "node scripts/audit-secret-exposure.mjs",
    "audit:performance": "node scripts/performance-budget-check.mjs",
    "audit:rules": "node scripts/audit-firebase-rules.mjs",
    "health:routes": "node scripts/route-health-check.mjs",
    "cleanup:production-data": "node scripts/cleanup-production-data.mjs",
    "deploy:rules": "node scripts/deploy-firebase-rules.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify:care-flow": "node scripts/verify-care-flow.mjs",
    "ci:smoke": "node scripts/ci-smoke.mjs",
    "e2e": "playwright test",
    "e2e:prod": "node scripts/run-e2e-prod.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "branch-protection:apply": "node scripts/apply-branch-protection.mjs",
    "ci:validate": "pnpm run audit:deps && pnpm run audit:secrets && pnpm run audit:performance && pnpm run format:check && pnpm run lint && pnpm run build && pnpm run ci:smoke"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@radix-ui/colors": "^3.0.0",
    "@react-google-maps/api": "^2.20.7",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^11.18.2",
    "google-auth-library": "^10.6.2",
    "lenis": "^1.3.23",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.511.0",
    "motion-primitives": "^0.1.0",
    "next": "^16.2.6",
    "posthog-js": "^1.376.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-scan": "^0.5.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@storybook/react": "10.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.14",
    "uuid": "11.1.1",
    "protobufjs": "7.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,css}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
